<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/nova_bg" android:paddingStart="30dp" android:paddingEnd="30dp" android:paddingTop="22dp" android:paddingBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOVA" android:textColor="@color/nova_text" android:textSize="34sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" TV" android:textColor="@color/nova_cyan" android:textSize="34sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:text="LIVE  •  YOUR WORLD, ONE SCREEN" android:textColor="@color/nova_muted" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/pageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Explorez les chaînes" android:textColor="@color/nova_text" android:textSize="22sp" android:textStyle="bold" android:paddingBottom="12dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OK : ouvrir     BACK : retour     Importez uniquement des flux gratuits et autorisés" android:textColor="@color/nova_muted" android:textSize="12sp" android:paddingTop="12dp" />
</LinearLayout>
